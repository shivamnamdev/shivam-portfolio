{
  "name": "shivam-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:all": "playwright test",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "test:admin-api": "E2E_SEED_PERSONAS=1 playwright test tests/unit/admin-api tests/api/admin-api --project=chromium --workers=1",
    "test:seeded": "E2E_SEED_PERSONAS=1 playwright test --project=chromium"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
