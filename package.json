    "@supabase/supabase-js": "^2.104.1",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "jspdf": "^4.2.1",
    "lucide-react": "latest",
    "next": "^15.5.29",
    "nodemailer": "^10.4.0",
    "openai": "^6.35.0",
    "pdf-lib": "^1.17.1",
    "pyodide": "^0.26.4",
    "razorpay": "^2.9.6",
    "react": "^18",
    "react-dom": "^18",
